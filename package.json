{
  "name": "zerodivision-civic-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Civic Issue Reporting & Resolution Platform (4-Module Mutex Architecture)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:authority": "npm run dev --workspace=authority-portal",
    "dev:citizen": "npm run dev --workspace=citizen-portal",
    "dev:command": "npm run dev --workspace=command-center",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rimraf apps/*/dist packages/*/dist apps/*/node_modules packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "rimraf": "^5.0.7"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
